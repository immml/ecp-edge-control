# ============================================================
# 边缘计算节点控制平台 · .gitignore
# ============================================================

# ---------- 虚拟环境（各组件独立 .venv/<组件名>）----------
.venv/
venv/
env/
ENV/

# ---------- Go ----------
# Go 用 go.mod/go.sum 锁定版本，不提交编译产物与模块缓存
bin/
dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work.sum

# ---------- Node / 前端 ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
.cache/
coverage/
*.local

# ---------- Python（脚本与工具链）----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 密钥与凭据（绝不入库）----------
.deploy/ssh/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
*.token

# ---------- 环境变量与本地配置 ----------
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
config.local.*
.dev.local/

# ---------- 证书（生成的运行期证书）----------
certs/*.crt
certs/*.key
certs/*.csr
!certs/.gitkeep

# ---------- 数据库与运行时数据 ----------
*.db
*.sqlite
*.sqlite3
data/
runtime/
logs/
*.log

# ---------- IDE / 编辑器 ----------
.vscode/*
!.vscode/settings.example.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 构建与临时产物 ----------
tmp/
temp/
.build/
out/
target/

# ---------- Cloudflare Worker ----------
worker/.wrangler/
worker/node_modules/
worker/dist/
.dev.vars
!.dev.vars.example

# ---------- 开发日志中的临时文件（保留 .md）----------
开发日志/**/*.tmp
开发日志/**/*.bak

# ---------- 工具运行时数据（WorkBuddy 项目数据）----------
# 注意：这是工具数据目录，不删除，仅不纳入版本控制
.workbuddy/
